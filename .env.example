# 数据库（SQLite 本地文件，无需更改）
DATABASE_URL="file:./dev.db"

# LLM 提供商选择：mock | openai | deepseek
# mock: 无需 API Key，使用内置 fixture 数据，适合本地体验
# openai: 使用 OpenAI API（GPT-4o）
# deepseek: 使用 DeepSeek API（推荐，国内可用且便宜）
LLM_PROVIDER=mock

# OpenAI（LLM_PROVIDER=openai 时填写）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# DeepSeek（LLM_PROVIDER=deepseek 时填写）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
